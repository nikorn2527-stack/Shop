# Reference for a NEW Windows installation, separate from Railway data/secrets.
# Existing installations must retain their existing paths and secrets.
DEPLOYMENT_MODE=onpremise
NODE_ENV=production
SEED_DEMO_DATA=0
SHOP_DATABASE_PROVIDER=sqlite
# SQLITE_DB_PATH=C:/ProgramData/PNGShop/data/welfare-store.sqlite
# SQLITE_BACKUP_DIR=C:/ProgramData/PNGShop/backups
# JWT_SECRET=   # Set a NEW random secret for this installation; do not reuse Railway's.
# Test rehearsal: use pnpm.cmd test:lan and its isolated .lan-test directory.
# PostgreSQL runtime support is not enabled by these settings.

SHOP_RELEASE_CHANNEL=windows-final
