# Reference only: retain existing Railway Variables and its persistent volume.
# Do not upload a local database or overwrite credentials during a code update.
DEPLOYMENT_MODE=cloud
CLOUD_PROVIDER=railway
NODE_ENV=production
SEED_DEMO_DATA=0
# Keep SQLITE_DB_PATH, SQLITE_BACKUP_DIR and JWT_SECRET at their EXISTING values.
# The current application uses SQLite. This file does not enable PostgreSQL.

SHOP_RELEASE_CHANNEL=railway-live
