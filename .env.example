# ============================================================
# ตัวอย่างการตั้งค่าสภาพแวดล้อม (แอปร้านค้าสวัสดิการ)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env       (Windows CMD)
#
# สำคัญ: โหมดพัฒนา (pnpm dev) รันได้เลยโดยไม่ต้องสร้าง .env
#       ทุกค่าด้านล่างมีค่าเริ่มต้นที่ใช้งานได้ทันที
# ============================================================

# ---------- ฐานข้อมูล SQLite ----------
# ตำแหน่งไฟล์ฐานข้อมูลหลัก (สัมพัทธ์จากรากโปรเจกต์)
# ค่าเริ่มต้น: data/welfare-store.sqlite
# SQLITE_DB_PATH=data/welfare-store.sqlite

# ข้อมูลตัวอย่างสำหรับทดสอบระบบ (ROUND 61)
# ค่าเริ่มต้น: ปิด — ติดตั้งใหม่เริ่มฐานข้อมูลว่างเปล่า 100% ตามที่ร้านต้องการ
# ข้อมูลจริงขึ้นระบบด้วยเทมเพลต .xlsx (ตั้งค่า → นำเข้าข้อมูล) หรือกรอกเอง
# นักพัฒนา/ผู้ทดสอบที่อยากได้ข้อมูลตัวอย่างทันที (สมาชิก/สินค้า/บิล + บัญชี
# ทดสอบ kanyanat/woraphot ในโหมด dev): เปิดบรรทัดนี้ — มีผลเฉพาะฐานข้อมูลที่ยังว่าง
# SEED_DEMO_DATA=1

# โฟลเดอร์เก็บไฟล์สำรองข้อมูล (timestamped + integrity check)
# ค่าเริ่มต้น: data/backups
# SQLITE_BACKUP_DIR=data/backups

# จำนวนวันเก็บไฟล์สำรอง (เก่ากว่านี้ถูกลบอัตโนมัติ)
# ค่าเริ่มต้น: 30
# SQLITE_BACKUP_RETENTION_DAYS=30

# ---------- เซิร์ฟเวอร์ ----------
# พอร์ตที่ใช้รันแอป (ถ้าพอร์ตถูกใช้อยู่ ระบบจะหาพอร์ตว่างถัดไปให้อัตโนมัติ)
# ค่าเริ่มต้น: 3000
# PORT=3000

# ---------- HTTPS สำหรับกล้องบนอุปกรณ์ที่เข้าผ่าน IP วงแลน ----------
# เบราว์เซอร์ (Chrome/Edge/Safari) อนุญาตให้เปิด "กล้อง" เฉพาะหน้าเว็บ
# HTTPS หรือ localhost เท่านั้น — ถ้าแท็บเล็ต/มือถือเข้าระบบผ่าน
# http://192.168.x.x:3001 ปุ่มกล้อง (สแกนบาร์โค้ด) จะกดไม่ได้
#
# วิธีแก้: เปิด HTTPS=1 แล้วรีสตาร์ทเซิร์ฟเวอร์ (Ctrl+C แล้ว pnpm dev ใหม่)
#  - ระบบสร้างใบรับรอง self-signed ให้เองที่ data/https/ (ไม่ต้องติดตั้ง openssl)
#  - อุปกรณ์ทุกเครื่องเข้าด้วย https://IP:พอร์ต แทน http://
#  - ครั้งแรกจะมีหน้าเตือน "ไม่ปลอดภัย" → กด ขั้นสูง → ดำเนินการต่อ ครั้งเดียว
#  - ถ้าไอพีเครื่องเปลี่ยน (DHCP) ระบบสร้างใบรับรองใหม่ให้อัตโนมัติตอนบูต
# HTTPS=1

# โฟลเดอร์เก็บใบรับรอง HTTPS (ปกติไม่ต้องเปลี่ยน)
# ค่าเริ่มต้น: data/https
# HTTPS_CERT_DIR=data/https

# ---------- ความปลอดภัย (เฉพาะ production ควรตั้ง) ----------
# คีย์สำหรับเซ็น session token ของ platform layer
# โหมดพัฒนาไม่จำเป็น · production แนะนำตั้งค่าสุ่มยาว ๆ เช่นผลจาก:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# ---------- (ไม่จำเป็นสำหรับการใช้งาน local) ----------
# ค่าด้านล่างใช้กับโครงสร้าง Manus WebDev เดิม (MySQL / OAuth platform)
# แอปร้านค้าสวัสดิการใช้ SQLite + ระบบล็อกอินภายในของตัวเอง จึงไม่ต้องตั้ง
# DATABASE_URL=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# VITE_APP_ID=
